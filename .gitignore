# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
# not used by the dev setup, but `.env.docker.example` is meant to be copied
# here as `.env`, and it holds secrets
/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

package-lock.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# JSON report, written by the CI reporter (see playwright.config.ts)
/playwright-results.json

/tests/test-data.json

# IDE files
/.vscode

# Database
data.db
data.test.db
data.*.db-journal

# Admin-uploaded files (location images)
/uploads
/uploads-test

# Database and uploads bind-mounted into the container by
# `make test-e2e-docker` (see docs/dev/testing.md § Testing the Docker image)
/.e2e-docker

# Database and uploads seeded by `make dump-release-db`
# (see docs/dev/testing.md § Release-upgrade tests)
/.release-dump

# Results and traces of scripts/e2e-flake-hunt.sh
# (see docs/dev/testing.md § Flake hunting)
/.flake-hunt

# Nix
flake.nix
flake.lock
result*

# Config file for jip, a stacked PR tool (see: https://github.com/omarkohl/jip)
.jip.local.toml

# Generated documentation site (see docs/dev/documentation.md)
site/

# Generated marketing site (see docs/dev/documentation.md § The landing page)
www-site/

# Build config assembled by scripts/build-docs.sh from docmd.config.json plus
# the versions it reconstructs from git tags.
.docmd.build.json

# Spec-Kit for Claude
.specify/
.claude/skills/speckit-*/

# Dev-server config for Claude Code's preview pane -- local tooling, and the
# command it runs depends on where node lives on the machine
.claude/launch.json

# Dependency graph rendered by `make arch-graph`.
arch-graph.svg

# Copy to .env and fill in values before running docker compose

# Version of Schellingboard to run, e.g. a release tag (default: latest)
SCHELLINGBOARD_VERSION=latest

# Site password — leave empty to disable authentication
SITE_PASSWORD=

# Password for the /admin UI — leave empty to disable it
ADMIN_PASSWORD=

# HMAC secret for auth cookies — required when SITE_PASSWORD or ADMIN_PASSWORD is set
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Host port to expose (default: 3000)
HOST_PORT=3000

# Email — leave all blank to disable sending email. Otherwise set SMTP_FROM
# and either SMTP_URL (which already includes host/port/user/password/security)
# or SMTP_HOST plus the PORT/USER/PASSWORD/SECURE variables below — not both.
# See https://docs.schellingboard.org/self-hosting/configuration/#email for details.
SMTP_FROM=

# The site's public base URL, e.g. https://sessions.example.org — used so
# emails can link back to the site. Required when email is configured.
SITE_URL=

# How often to send due attendee-count reminders, in milliseconds
# (default: 60000). Set to 0 to switch those two emails off entirely.
REMINDER_DISPATCH_INTERVAL_MS=

# Option A: a single connection URL, e.g. smtp://user:pass@localhost:1025
SMTP_URL=

# Option B: individual settings (used only if SMTP_URL is blank)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
